# Public base URL of the site, used for canonical/Open Graph URLs, robots.txt
# and sitemap.xml. Optional on Vercel: falls back to the project's production
# domain (VERCEL_PROJECT_PRODUCTION_URL), then to https://baywashcare.com.
NEXT_PUBLIC_SITE_URL=https://baywashcare.com

# Neon Postgres (launch waitlist). `neon deploy` / `neon env pull` fills these
# into .env.local; on Vercel add them as project environment variables.
# Pooled (-pooler host): used by the app at runtime.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct (no -pooler): used only by `npm run db:migrate`.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require
